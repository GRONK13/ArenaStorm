# Multi-stage build for ArenaStorm Web API
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /app

# Copy csproj files and restore dependencies
COPY src/ArenaStorm.Shared/ArenaStorm.Shared.csproj src/ArenaStorm.Shared/
COPY src/ArenaStorm.WebAPI/ArenaStorm.WebAPI.csproj src/ArenaStorm.WebAPI/
RUN dotnet restore src/ArenaStorm.WebAPI/ArenaStorm.WebAPI.csproj

# Copy source code and publish
COPY src/ArenaStorm.Shared/ src/ArenaStorm.Shared/
COPY src/ArenaStorm.WebAPI/ src/ArenaStorm.WebAPI/
RUN dotnet publish src/ArenaStorm.WebAPI/ArenaStorm.WebAPI.csproj -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_HTTP_PORTS=5000
EXPOSE 5000

ENTRYPOINT ["dotnet", "ArenaStorm.WebAPI.dll"]
